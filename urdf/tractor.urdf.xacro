<?xml version="1.0"?>
<!--
  Motoculteur agricole - modèle pour Gazebo Harmonic (gz-sim 8) / ROS 2 Jazzy
  ===========================================================================
  CONVENTION DE REPÈRE (REP-103), appliquée à TOUTES les pièces :
    X+ = avant du robot (sens de marche)
    Y+ = gauche
    Z+ = haut
  L'origine de base_link est placée AU CENTRE DE MASSE du châssis, à la hauteur
  de l'axe des roues. Ainsi la force du guidon peut être convertie en
  (force + couple) sur base_link sans ambiguïté sur le point d'application.

  Vue de dessus (X vers la droite) :

     guidon        éperon      CdM     axe roues    caméra
       o=============|==========+=========||==========[]
    x=-1.00       x=-0.45      0.00     x=+0.20     x=+0.35

  Propulsion : UN SEUL lien "axle_link" (essieu rigide) qui porte les deux
  roues comme collisions -> les deux roues tournent forcément à la même vitesse.
  Direction : aucune. On pousse latéralement le guidon ; l'éperon accroche le sol
  et sert de pivot ; les roues glissent latéralement (mu latéral faible).
-->
<robot name="tractor" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ====================== Paramètres géométriques ====================== -->
  <xacro:property name="PI" value="3.14159265359"/>

  <xacro:property name="wheel_radius" value="0.25"/>
  <xacro:property name="wheel_width"  value="0.12"/>
  <xacro:property name="wheel_track"  value="0.60"/>   <!-- entraxe gauche/droite -->
  <xacro:property name="axle_x"       value="0.20"/>   <!-- essieu devant le CdM -->

  <xacro:property name="chassis_mass" value="90.0"/>
  <xacro:property name="chassis_lx"   value="0.70"/>
  <xacro:property name="chassis_ly"   value="0.45"/>
  <xacro:property name="chassis_lz"   value="0.35"/>
  <xacro:property name="chassis_z"    value="0.12"/>   <!-- centre de la boîte au-dessus de l'axe -->

  <xacro:property name="axle_mass"    value="20.0"/>   <!-- essieu + 2 roues -->

  <xacro:property name="eperon_x"     value="-0.45"/>
  <xacro:property name="eperon_r"     value="0.03"/>   <!-- rayon de la sphère de contact -->

  <xacro:property name="handle_x"     value="-1.00"/>
  <xacro:property name="handle_z"     value="0.65"/>   <!-- ~0.90 m au-dessus du sol -->

  <xacro:property name="camera_x"     value="0.35"/>
  <xacro:property name="camera_z"     value="0.55"/>
  <xacro:property name="camera_pitch" value="0.15"/>   <!-- légèrement vers le sol -->

  <!-- ====================== Friction (voir README, Étape 3) ====================== -->
  <!-- Roues : mu1 sur fdir1 = axe du cylindre = LATÉRAL (faible -> glissement)
               mu2 = LONGITUDINAL (traction) -->
  <xacro:property name="wheel_mu_lat"  value="0.30"/>
  <xacro:property name="wheel_mu_long" value="1.00"/>
  <!-- Éperon : il "laboure" le sol, résistance élevée dans toutes les directions -->
  <xacro:property name="eperon_mu"     value="3.00"/>

  <!-- ====================== Macros d'inertie ====================== -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertia ixx="${m*(y*y+z*z)/12}" ixy="0" ixz="0"
             iyy="${m*(x*x+z*z)/12}" iyz="0"
             izz="${m*(x*x+y*y)/12}"/>
  </xacro:macro>
  <xacro:macro name="tiny_inertial">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
  </xacro:macro>

  <material name="orange"><color rgba="0.95 0.45 0.05 1"/></material>
  <material name="black"><color rgba="0.08 0.08 0.08 1"/></material>
  <material name="grey"><color rgba="0.5 0.5 0.5 1"/></material>
  <material name="blue"><color rgba="0.1 0.2 0.8 1"/></material>

  <!-- ====================== base_link (châssis + moteur) ====================== -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>   <!-- CdM = origine : NE PAS DÉPLACER -->
      <mass value="${chassis_mass}"/>
      <xacro:box_inertia m="${chassis_mass}" x="${chassis_lx}" y="${chassis_ly}" z="${chassis_lz}"/>
    </inertial>
    <visual>
      <origin xyz="0.05 0 ${chassis_z}" rpy="0 0 0"/>
      <geometry><box size="${chassis_lx} ${chassis_ly} ${chassis_lz}"/></geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0.05 0 ${chassis_z}" rpy="0 0 0"/>
      <geometry><box size="${chassis_lx} ${chassis_ly} ${chassis_lz}"/></geometry>
    </collision>
  </link>

  <!-- ====================== Essieu rigide + roues ====================== -->
  <link name="axle_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${axle_mass}"/>
      <!-- approx : 2 cylindres pleins décalés de +-track/2 -->
      <inertia ixx="${axle_mass*(3*wheel_radius*wheel_radius+wheel_width*wheel_width)/12 + axle_mass*(wheel_track/2)*(wheel_track/2)}"
               ixy="0" ixz="0"
               iyy="${axle_mass*wheel_radius*wheel_radius/2}" iyz="0"
               izz="${axle_mass*(3*wheel_radius*wheel_radius+wheel_width*wheel_width)/12 + axle_mass*(wheel_track/2)*(wheel_track/2)}"/>
    </inertial>
    <!-- Roue gauche -->
    <visual>
      <origin xyz="0 ${wheel_track/2} 0" rpy="${PI/2} 0 0"/>
      <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      <material name="black"/>
    </visual>
    <collision name="wheel_left_collision">
      <origin xyz="0 ${wheel_track/2} 0" rpy="${PI/2} 0 0"/>
      <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
    </collision>
    <!-- Roue droite -->
    <visual>
      <origin xyz="0 ${-wheel_track/2} 0" rpy="${PI/2} 0 0"/>
      <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
      <material name="black"/>
    </visual>
    <collision name="wheel_right_collision">
      <origin xyz="0 ${-wheel_track/2} 0" rpy="${PI/2} 0 0"/>
      <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
    </collision>
    <!-- Barre d'essieu (visuel) -->
    <visual>
      <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
      <geometry><cylinder radius="0.025" length="${wheel_track}"/></geometry>
      <material name="grey"/>
    </visual>
  </link>

  <joint name="axle_joint" type="continuous">
    <parent link="base_link"/>
    <child link="axle_link"/>
    <origin xyz="${axle_x} 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>   <!-- rotation + => avance en X+ -->
    <limit effort="300" velocity="20"/>
    <dynamics damping="0.5" friction="0.0"/>
  </joint>

  <!-- ====================== Éperon de terrage (ARRIÈRE, X-) ====================== -->
  <link name="eperon_link">
    <xacro:tiny_inertial/>
    <visual>
      <origin xyz="0 0 ${-wheel_radius/2 + eperon_r/2}" rpy="0 0 0"/>
      <geometry><box size="0.04 0.02 ${wheel_radius}"/></geometry>
      <material name="grey"/>
    </visual>
    <collision name="eperon_collision">
      <!-- bas de la sphère au niveau du bas des roues (z = -wheel_radius) -->
      <origin xyz="0 0 ${-wheel_radius + eperon_r}" rpy="0 0 0"/>
      <geometry><sphere radius="${eperon_r}"/></geometry>
    </collision>
  </link>
  <joint name="eperon_joint" type="fixed">
    <parent link="base_link"/>
    <child link="eperon_link"/>
    <origin xyz="${eperon_x} 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ====================== Guidon (ARRIÈRE, X-) ====================== -->
  <link name="guidon_link">
    <xacro:tiny_inertial/>
    <visual>  <!-- poignée transversale -->
      <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
      <geometry><cylinder radius="0.02" length="0.60"/></geometry>
      <material name="blue"/>
    </visual>
  </link>
  <joint name="guidon_joint" type="fixed">
    <parent link="base_link"/>
    <child link="guidon_link"/>
    <origin xyz="${handle_x} 0 ${handle_z}" rpy="0 0 0"/>
  </joint>
  <!-- Mancherons reliant le châssis au guidon (visuels seulement) -->
  <link name="mancherons_link">
    <xacro:tiny_inertial/>
    <visual>
      <!-- barre de (-0.2, 0, 0.2) jusqu'au guidon -->
      <origin xyz="${(handle_x - 0.2)/2} 0 ${(handle_z + 0.2)/2}"
              rpy="0 ${atan2(handle_z - 0.2, -(handle_x + 0.2))} 0"/>
      <geometry><box size="${sqrt((handle_x+0.2)**2 + (handle_z-0.2)**2)} 0.30 0.04"/></geometry>
      <material name="grey"/>
    </visual>
  </link>
  <joint name="mancherons_joint" type="fixed">
    <parent link="base_link"/>
    <child link="mancherons_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ====================== Caméra (AVANT, X+) ====================== -->
  <link name="camera_link">
    <xacro:tiny_inertial/>
    <visual>
      <geometry><box size="0.05 0.12 0.05"/></geometry>
      <material name="black"/>
    </visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="camera_link"/>
    <origin xyz="${camera_x} 0 ${camera_z}" rpy="0 ${camera_pitch} 0"/>
  </joint>
  <!-- Repère optique (Z vers l'avant) pour RViz / OpenCV -->
  <link name="camera_link_optical"/>
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link"/>
    <child link="camera_link_optical"/>
    <origin xyz="0 0 0" rpy="${-PI/2} 0 ${-PI/2}"/>
  </joint>

  <!-- =====================================================================
       GAZEBO
       ===================================================================== -->

  <!-- Garder l'éperon comme lien séparé pour que SA friction lui soit propre
       (sinon il serait fusionné dans base_link). -->
  <gazebo reference="eperon_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>

  <gazebo reference="axle_link">
    <mu1>${wheel_mu_lat}</mu1>
    <mu2>${wheel_mu_long}</mu2>
    <!-- fdir1 dans le repère de la collision : axe du cylindre = latéral robot -->
    <fdir1>0 0 1</fdir1>
    <kp>1e6</kp>
    <kd>100</kd>
    <minDepth>0.001</minDepth>
  </gazebo>

  <gazebo reference="eperon_link">
    <mu1>${eperon_mu}</mu1>
    <mu2>${eperon_mu}</mu2>
    <kp>1e6</kp>
    <kd>100</kd>
    <minDepth>0.001</minDepth>
  </gazebo>

  <gazebo reference="base_link">
    <mu1>0.6</mu1>
    <mu2>0.6</mu2>
  </gazebo>

  <!-- Caméra -->
  <gazebo reference="camera_link">
    <sensor name="front_camera" type="camera">
      <always_on>1</always_on>
      <update_rate>30</update_rate>
      <visualize>true</visualize>
      <topic>camera/image_raw</topic>
      <gz_frame_id>camera_link_optical</gz_frame_id>
      <camera>
        <horizontal_fov>1.2</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>100</far>
        </clip>
      </camera>
    </sensor>
  </gazebo>

  <gazebo>
    <!-- Vitesse de l'essieu (rad/s) reçue sur /wheel_cmd (gz.msgs.Double) -->
    <plugin filename="gz-sim-joint-controller-system"
            name="gz::sim::systems::JointController">
      <joint_name>axle_joint</joint_name>
      <topic>wheel_cmd</topic>
      <initial_velocity>0.0</initial_velocity>
    </plugin>

    <!-- Odométrie "vérité terrain" (pose + twist) -->
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf_gz</tf_topic>
      <dimensions>3</dimensions>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

</robot>
