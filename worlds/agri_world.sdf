        <visual name="p0"><pose>2.000 -0.753 0.153 0 0 0</pose><geometry><sphere><radius>0.161</radius></sphere></geometry><material><ambient>0.057 0.380 0.038 1</ambient><diffuse>0.057 0.380 0.038 1</diffuse></material></visual>
